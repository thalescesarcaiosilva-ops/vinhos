# Supabase — https://supabase.com/dashboard/project/aufvvgytbrstsrfomngm/settings/api
# IMPORTANTE: use sempre a URL *.supabase.co — NÃO coloque o domínio da loja aqui.
# Preferir Legacy anon JWT (eyJ...) se sb_publishable_ falhar com "Invalid API key".
VITE_SUPABASE_URL=https://aufvvgytbrstsrfomngm.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sua-chave-anon-jwt-eyJ
VITE_SUPABASE_PROJECT_ID=aufvvgytbrstsrfomngm
SUPABASE_URL=https://aufvvgytbrstsrfomngm.supabase.co
SUPABASE_PUBLISHABLE_KEY=sua-chave-anon-jwt-eyJ
# Checkout/admin: JWT legacy obrigatório (eyJ...) — sb_secret_ não autentica no PostgREST.
# Dashboard → Settings → API → Legacy API Keys → service_role
SUPABASE_LEGACY_SERVICE_ROLE_KEY=eyJ...
# Opcional se for JWT legacy; ignore sb_secret_ aqui para operações de banco
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# URL pública do site (SEO, webhooks, OAuth) — domínio da loja, separado do Supabase.
PUBLIC_SITE_URL=https://www.galvaovinhos.com.br
VITE_PUBLIC_SITE_URL=https://www.galvaovinhos.com.br

# PayoutBR (checkout — PIX e cartão)
# Painel: Configurações → Credenciais de API
PAYOUTBR_SECRET_KEY=sua-chave-secreta
PAYOUTBR_PUBLIC_KEY=sua-chave-publica
# Opcional — padrão: https://api.payoutbr.com.br/v1
# PAYOUTBR_API_URL=https://api.payoutbr.com.br/v1

# Upload em lote de imagens via API (opcional)
UPLOAD_TOKEN=seu-token-secreto

# Resend — e-mail de confirmação de pedido (também usado no Auth SMTP do Supabase, se configurado)
# https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxx
# Remetente verificado no Resend (domínio galvaovinhos.com.br)
RESEND_FROM=Galvao Vinhos <atendimento@galvaovinhos.com.br>

# Track7 — rastreio na loja (/rastreio) via API (chave só no servidor)
# https://track7.app — header X-API-Key
TRACK7_API_KEY=t7_xxxxxxxx
# Opcional (padrão https://track7.app/api/v1)
# TRACK7_API_URL=https://track7.app/api/v1
