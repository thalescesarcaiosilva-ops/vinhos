{
  "redirects": [
    {
      "source": "/pagina/:slug",
      "destination": "/politicas/:slug",
      "permanent": true
    },
    {
      "source": "/colecao/ate-100",
      "destination": "/colecao/todos?max=100",
      "permanent": true
    },
    {
      "source": "/colecao/100-200",
      "destination": "/colecao/todos?min=100&max=200",
      "permanent": true
    },
    {
      "source": "/colecao/200-300",
      "destination": "/colecao/todos?min=200&max=300",
      "permanent": true
    },
    {
      "source": "/colecao/acima-300",
      "destination": "/colecao/todos?min=300",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/rest/v1/:path*",
      "destination": "https://aufvvgytbrstsrfomngm.supabase.co/rest/v1/:path*"
    },
    {
      "source": "/auth/v1/:path*",
      "destination": "https://aufvvgytbrstsrfomngm.supabase.co/auth/v1/:path*"
    },
    {
      "source": "/storage/v1/:path*",
      "destination": "https://aufvvgytbrstsrfomngm.supabase.co/storage/v1/:path*"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/storage/v1/object/public/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "all" },
        { "key": "Cache-Control", "value": "public, max-age=2592000, stale-while-revalidate=86400" }
      ]
    },
    {
      "source": "/storage/v1/render/image/public/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "all" },
        { "key": "Cache-Control", "value": "public, max-age=2592000, stale-while-revalidate=86400" }
      ]
    }
  ]
}
